# ============================================
# Environment Variables - Marine Equipment QR System
# Copy this file to .env and fill in actual values
# ============================================

# ----------------------------------------
# Application Settings
# ----------------------------------------
APP_NAME=Marine Equipment QR System
APP_VERSION=0.1.0
DEBUG=false

# Architecture: arm64 (NAS) or amd64 (Windows dev)
ARCH=arm64

# ----------------------------------------
# Security Settings (REQUIRED)
# ----------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-please-generate-a-new-one

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
TEMP_TOKEN_EXPIRE_MINUTES=3

# ----------------------------------------
# Network Ports
# ----------------------------------------
HTTP_PORT=8080
HTTPS_PORT=8443

# ----------------------------------------
# CORS Settings
# ----------------------------------------
# JSON array of allowed origins
# Example: ["http://localhost:8080", "https://nas.example.ts.net"]
BACKEND_CORS_ORIGINS=["http://localhost:8080"]

# ----------------------------------------
# QR Code Settings
# ----------------------------------------
# Domain for QR code URLs (generated in equipment QR codes)
# IMPORTANT: Must include port number if not using standard port (80/443)
# Example: localhost:8080, your-nas.ts.net:8443
QR_CODE_DOMAIN=localhost:8080
QR_CODE_PROTOCOL=http

# ----------------------------------------
# SSL/TLS Settings (for HTTPS)
# ----------------------------------------
# Path to SSL certificates directory
# Should contain: server.crt and server.key
SSL_CERT_PATH=./ssl

# ============================================
# CONFIGURATION TEMPLATES
# ============================================

# ----------------------------------------
# [TEMPLATE] Windows x64 Development (HTTP)
# ----------------------------------------
# ARCH=amd64
# DEBUG=true
# SECRET_KEY=dev-secret-key-for-local-only
# HTTP_PORT=8080
# BACKEND_CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]
# QR_CODE_DOMAIN=localhost:8080
# QR_CODE_PROTOCOL=http

# ----------------------------------------
# [TEMPLATE] Synology NAS with Tailscale (HTTPS)
# ----------------------------------------
# NOTE: Use port 8080/8443 to avoid conflict with DSM (port 80/443/5001)
# IMPORTANT: QR_CODE_DOMAIN must include port if not using standard 443
#
# ARCH=arm64
# DEBUG=false
# SECRET_KEY=<generate-secure-key>
# HTTP_PORT=8080
# HTTPS_PORT=8443
# SSL_CERT_PATH=/volume1/docker/marine-equipment/ssl
# DATA_PATH=/volume1/docker/marine-equipment/data
# UPLOADS_PATH=/volume1/docker/marine-equipment/uploads
# BACKEND_CORS_ORIGINS=["https://your-machine.tail-xxxxx.ts.net:8443"]
# QR_CODE_DOMAIN=your-machine.tail-xxxxx.ts.net:8443
# QR_CODE_PROTOCOL=https

# ----------------------------------------
# [TEMPLATE] Synology NAS Internal Only (HTTP)
# ----------------------------------------
# ARCH=arm64
# DEBUG=false
# SECRET_KEY=<generate-secure-key>
# HTTP_PORT=8080
# BACKEND_CORS_ORIGINS=["http://192.168.1.100:8080"]
# QR_CODE_DOMAIN=192.168.1.100:8080
# QR_CODE_PROTOCOL=http
