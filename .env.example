# ============================================
# 環境變數範本 - Marine Equipment QR System
# 複製此檔案為 .env 並填入實際值
# ============================================

# ----------------------------------------
# 應用程式設定
# ----------------------------------------
APP_NAME=Marine Equipment QR System
APP_VERSION=0.1.0
DEBUG=false

# ----------------------------------------
# 安全性設定 (必填)
# ----------------------------------------
# 產生方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-please-generate-a-new-one

# JWT 設定
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
TEMP_TOKEN_EXPIRE_MINUTES=3

# ----------------------------------------
# CORS 設定
# ----------------------------------------
# JSON 格式的允許來源列表
# 範例: ["http://localhost:8080", "https://your-domain.com"]
BACKEND_CORS_ORIGINS=["http://localhost:8080"]

# ----------------------------------------
# QR Code 設定
# ----------------------------------------
# QR Code 掃描後導向的域名
QR_CODE_DOMAIN=localhost:8080
QR_CODE_PROTOCOL=http

# ----------------------------------------
# 前端設定
# ----------------------------------------
# 前端服務暴露的端口
FRONTEND_PORT=8080

# ----------------------------------------
# 生產環境建議設定
# ----------------------------------------
# DEBUG=false
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# BACKEND_CORS_ORIGINS=["https://your-nas-ip:8080"]
# QR_CODE_DOMAIN=your-nas-ip:8080
# QR_CODE_PROTOCOL=https
